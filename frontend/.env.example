# ─────────────────────────────────────────────────────────────────────────────
# FlashMVP Frontend — Environment Variables
# Copy this file to .env.local and fill in your values.
# Variables MUST start with VITE_ to be exposed to the browser bundle.
# NEVER put the SERVICE KEY here — that lives in backend/.env only.
# ─────────────────────────────────────────────────────────────────────────────

# Demo mode — set to "false" to use real Supabase auth
VITE_DEMO_MODE=true

# Your Supabase project URL (same value as backend SUPABASE_URL)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon / public key only — this is safe to expose in the browser
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Backend API base URL
VITE_API_URL=http://localhost:8000
