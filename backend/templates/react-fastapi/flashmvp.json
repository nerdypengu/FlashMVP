{
  "name": "react-fastapi",
  "template": "react-fastapi",
  "ibm_bindings": {
    "ibm_code_engine": true,
    "ibm_postgres_db": true,
    "ibm_secrets_manager": true,
    "ibm_watsonx_qa": true
  },
  "services": [
    { "name": "frontend", "dockerfile": "Dockerfile.frontend", "port": 3000 },
    { "name": "backend",  "dockerfile": "Dockerfile.backend",  "port": 8000 }
  ],
  "qa_pipeline": [
    { "stage": "Unit Tests", "files": ["backend/tests/test_*.py"] },
    { "stage": "Integration Tests", "files": ["backend/tests/integration/test_*.py"] },
    { "stage": "E2E Tests", "files": ["frontend/e2e/*.spec.ts"] }
  ]
}
