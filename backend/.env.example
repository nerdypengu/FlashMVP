# ─────────────────────────────────────────────────────────────────────────────
# FlashMVP Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime mode ─────────────────────────────────────────────────────────────
# true  = demo mode (no real DB/Docker needed, returns mock data)
# false = live mode (real Supabase + Docker connections)
DEMO_MODE=true

# ── Supabase connection ───────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API

# Your project's public URL  (e.g. https://xyzxyzxyz.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Anon / public key  — safe to expose to browsers, used for user-scoped queries
# Supabase RLS policies restrict what this key can see/do per user role.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — KEEP THIS SECRET, never expose to frontend.
# Bypasses all RLS policies — used only by the backend for admin provisioning.
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Direct PostgreSQL connection string — used by asyncpg for raw SQL (schema creation).
# Found in: Supabase Dashboard → Project Settings → Database → Connection string (URI)
# Use the "Service role" / direct connection string (port 5432, NOT the pooler port 6543).
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ── Secrets vault encryption ──────────────────────────────────────────────────
# 32-byte Fernet key for encrypting stored API keys at rest.
# Generate one with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_ENCRYPTION_KEY=

# ── IBM Cloud (optional — for live IBM Code Engine deployment) ────────────────
IBM_API_KEY=
IBM_REGION=us-south
IBM_CODE_ENGINE_PROJECT_ID=
